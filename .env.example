# Copy this file to .env and fill in your key, or set these as real
# environment variables. Nothing here is read automatically unless you
# export them yourself — see the two setup options in README.md.

# Get a key at https://console.x.ai (or https://x.ai/api)
GROK_API_KEY=

# Optional. Defaults to grok-4 if not set.
# GROK_MODEL=grok-4

# Optional. Restrict widget embedding to your real site before going live.
# ALLOWED_ORIGINS=https://yourshop.com
